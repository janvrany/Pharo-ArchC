Class {
	#name : #AcAArch64OpcodeParser,
	#superclass : #Object,
	#instVars : [
		'document',
		'operandFormatMap',
		'operandInstantiationMap'
	],
	#classVars : [
		'XML2MAP'
	],
	#category : #'ArchC-AArch64-Parsing'
}

{ #category : #utilities }
AcAArch64OpcodeParser class >> extractIndex [
	| dir index source |

	dir := AcProcessorDescriptions baseDirectory asFilename / 'aarch64' / 'ISA_A64_xml_A_profile-2024-06'.
	index := OrderedCollection new.

	dir directoryContentsAsFilenames select: [ :file|
		file suffix = 'xml' ifTrue: [
			| xml |

			file readStreamDo: [ :s| xml := XMLDOMParser parse: s ].
			xml root name = 'instructionsection' ifTrue: [
				index add: {
					file baseName.
					(xml xpath: 'instructionsection/docvars/docvar[@key=''instr-class'']/@value') stringValue.
					"((xml xpath: 'instructionsection/desc/authored//text()') strings asArray join:'') trim"
				}
			]
		].
	].

	source := String streamContents: [ :s|
		s nextPutAll:'index';cr.
		s nextPutAll:'    ^ #(';cr.
		index do: [:entry |
			s nextPutAll:'        #('.
			s nextPutAll:entry first storeString; space.
			s nextPutAll:entry second storeString; space.
			"s nextPutAll:entry third storeString; space."
			s nextPutAll:')'; cr.
		].
		s nextPutAll:'    )';cr.
	].

	self class compile: source classified: 'private'

	"
	AcAArch64OpcodeParser extractIndex
	"
]

{ #category : #utilities }
AcAArch64OpcodeParser class >> extractOperands [
	| dir instrClasses operands |

	dir := AcProcessorDescriptions baseDirectory asFilename / 'aarch64' / 'ISA_A64_xml_A_profile-2024-06'.
	operands := Dictionary new.
	instrClasses := #('general').

	dir directoryContentsAsFilenames select: [ :file|
		file suffix = 'xml' ifTrue: [
			| xml |

			file readStreamDo: [ :s| xml := XMLDOMParser parse: s ].
			xml root name = 'instructionsection' ifTrue: [
				(instrClasses includes: (xml xpath: 'instructionsection/docvars/docvar[@key=''instr-class'']/@value') stringValue) ifTrue: [
					(xml // 'explanation') do: [:explanation |
						(explanation includesElement: 'account') ifTrue: [
							| name desc |

							name := (explanation / 'symbol' / 'text()') first stringValue.
							desc := (explanation / 'account' // 'para' / 'text()') strings asArray join:''.

							(operands at: name ifAbsentPut: [ OrderedCollection new ]) add: desc.

						].
					].
				]
			]
		].
	].
	^ operands.


	"
	AcAArch64OpcodeParser extractOperands
	"
]


{ #category : #initialization }
AcAArch64OpcodeParser class >> initialize [

	"Immediates"
	XML2MAP := Dictionary newFromPairs: #(

		'<imm>'     '%imm'
		'<imm5>'    '%imm'
		'<imm6>'    '%imm'

		'<uimm>'    '%imm'
		'<uimm6>'   '%imm'
		'<uimm4>'   '%imm'

		'<immr>'    '%imm'
		'<imms>'    '%imm'
		'<simm>'    '%imm' "<para>Is the optional signed immediate byte offset, in the range -256 to 255, defaulting to 0 and encoded in the 'imm9' field.</para>"
		'<pimm>'    '%imm'"<para>For the 32-bit variant: is the optional positive immediate byte offset, a multiple of 4 in the range 0 to 16380, defaulting to 0 and encoded in the 'imm12' field as &lt;pimm&gt;/4.</para>"

		'<amount>'  '%imm'
		'<label>'   '%imm(pcrel)'
		'<shift>'   '%imm'
		'<lsb>'     '%imm'
		'<width>'   '%imm'
		'<nzcv>'    '%imm' "<para>Is the flag bit specifier, an immediate in the range 0 to 15, giving the alternative state for the 4-bit NZCV condition flags, encoded in the 'nzcv' field.</para>"
		'<mask>'    '%imm' "<para>Is the flag bit mask, an immediate in the range 0 to 15, which selects the bits that are inserted into the NZCV condition flags, encoded in the 'mask' field.</para>"

		'<m>'       '%gpr64' "SIGH!!!"
		'<t>'       '%gpr64' "SIGH!!!"
	).

	"Registers. Here we generate all the combinations
	 since capitalization is not consistent and we need
	 variants where 31 means zero and where it means sp."
	#('d' 'n' 'm' 's' '(s+1)' 't' '(t+1)' 't1' 't2' 'a') do: [:reg |
		XML2MAP at: '<X' , reg , '>' put: '%gpr64'.
		XML2MAP at: '<x' , reg , '>' put: '%gpr64'.

		XML2MAP at: '<X' , reg , '|SP>' put: '%gpr64sp'.
		XML2MAP at: '<x' , reg , '|SP>' put: '%gpr64sp'.
		XML2MAP at: '<X' , reg , '|XSP>' put: '%gpr64sp'.
		XML2MAP at: '<x' , reg , '|XSP>' put: '%gpr64sp'.
		XML2MAP at: '<X' , reg , '|xSP>' put: '%gpr64sp'.
		XML2MAP at: '<x' , reg , '|xSP>' put: '%gpr64sp'.

		XML2MAP at: '<W' , reg , '>' put: '%gpr32'.
		XML2MAP at: '<w' , reg , '>' put: '%gpr32'.

		XML2MAP at: '<W' , reg , '|SP>' put: '%gpr32sp'.
		XML2MAP at: '<w' , reg , '|SP>' put: '%gpr32sp'.
		XML2MAP at: '<W' , reg , '|WSP>' put: '%gpr32sp'.
		XML2MAP at: '<w' , reg , '|WSP>' put: '%gpr32sp'.
		XML2MAP at: '<W' , reg , '|wSP>' put: '%gpr32sp'.
		XML2MAP at: '<w' , reg , '|wSP>' put: '%gpr32sp'.
	].
]

{ #category : #parsing }
AcAArch64OpcodeParser class >> parseFile: file in: path [
	| dir insns |

	dir := path asFileReference / file.
	dir isDirectory ifFalse: [ self error:'Expecing a directory with one .xml per instruction'. ^ nil ].

	insns := OrderedCollection new: 300.

	self index do: [:entry |
		(self skip includes: entry first) ifFalse: [
			entry second = 'general' ifTrue: [
				(self new parseFile: (dir / entry first)) do: [:insn |
					insns add: 'ac_instr' -> insn.
				].
			].
		].
	].

	^ insns
]

{ #category : #private }
AcAArch64OpcodeParser class >> skip [
	"Return list of files to skip when parsing.
	 This is a temporary measure to skip over
	 not yet supported instructions."

	^ #(
		'prfm_reg.xml'
	)
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseDocument [
	"Parse the XML document and return corresponsing instruction
	 (as ProcessorInstructionDeclaration)."
	| format syntax |

	operandFormatMap := Dictionary new.
	operandInstantiationMap := Dictionary new.

	format := self parseFormat.
			  self parseExplanations.
	syntax := self parseEncodings.

	^ {
		ProcessorInstructionDeclaration new
			name: (document root attributeAt: 'id');
			format: format;
			syntax: syntax;
			yourself.
	}
]

{ #category : #parsing }
AcAArch64OpcodeParser >> parseDocument: anXMLDocument [
	| instrClass |

	"For now, we only support general instructions"
	instrClass := (anXMLDocument xpath: 'instructionsection/docvars/docvar[@key=''instr-class'']/@value') stringValue.
	instrClass = 'general' ifFalse: [ ^ #() ].
	document := anXMLDocument.
	^ self parseDocument
	"
	[
	^ self parseDocument
	] on: Error do: [
		^ #()
	]
	"
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseEncoding: encodingNode [
	"Parse single <encoding/> element and return corresponsing
	 syntax object (instance of AcAsmSyntax).

	 Use given `operandInstantiationsMap` to map symbolic operand name
	 to its instantiation.
	"

	| format operands constraints |

	format := ''.
	operands := OrderedCollection new.
	(encodingNode / 'asmtemplate' / '*') do: [:chunk |
		chunk name = 'text' ifTrue: [
			format := format , chunk stringValue trimSeparators asLowercase.
		] ifFalse: [
		chunk name = 'a' ifTrue: [
			format := format , ' ' , (operandFormatMap at: chunk stringValue).
			operands add: (operandInstantiationMap at: (chunk attributeAt: 'link'))
		] ifFalse: [
			self error: 'Unsupported chunk type: ', chunk name
		]].
	].
	constraints := SmallDictionary new.
	(encodingNode // 'box') do: [:box |
		| name value |

		name := box attributeAt: 'name'.
		value := 0.
		(box / 'c') do: [:c |
			| v |

			self assert: (c includesAttribute: 'colspan') not.
			c hasChildren ifTrue: [
				v := c strings first = '1' ifTrue: [1] ifFalse: [0].
			] ifFalse: [
				v := 0 "Don't care bit".
			].
			value := (value << 1) | (v)
		].
		constraints at: name put: value.
	].

	^ AcAsmSyntax new
		format: (AcAArch64FormatParser parse: format);
		operands: operands;
		constraints: constraints;
		yourself
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseEncodings [
	"Parse all <encoding/>s in the XML file and return a set of
	 syntax objects (as AcAsmSyntax)"

	^ (document // 'encoding') collect: [:node |
		self parseEncoding: node
	].
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseExplanation: explanation [
	"Parse single <explanation/> element and entry into operandInstantiationMap
	 mapping symbolic operand name used in template to `AsmOperandInstantiation`
	 instance."

	| link name bitfields |

	link := ((explanation / 'symbol') @ 'link') stringValue.
	name := (explanation xpath: 'symbol/text()') stringValue.
	bitfields := ((explanation / '*') @ 'encodedin') stringValue splitBy: $:.

	operandInstantiationMap
			at: link
			put: (AsmOperandInstantiation new operands: bitfields).

	(explanation includesElement: 'account') ifTrue: [
		self assert: (explanation includesElement: 'definition') not.

		operandFormatMap at: name put: (XML2MAP at:name).
		^ self.
	].

	(explanation includesElement: 'definition') ifTrue: [
		| entries map |

		self assert: (explanation includesElement: 'account') not.

		entries := OrderedCollection new.

		(explanation xpath: 'definition/table[@class="valuetable"]//tbody/row') do:[:row|
			| names value |

			names := (row xpath: 'entry[@class=''symbol'']/text()') stringValue splitBy: $|.
			value := Integer readFrom: (row xpath: 'entry[@class=''bitfield'']/text()') stringValue base: 2.

			names do: [:link | entries add: (AcAsmMapEntry name: link value: value) ].

		].

		map := AcAsmMap name: (name copyFrom:2 to:name size -1) entries: entries.

		operandFormatMap at: name put: '%[', map name , ']'.
		^ self.
	].

	self assert: false description: 'Neither <account/> nor <definition/> elements'.
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseExplanations [
	(document // 'explanation') do: [:each |
		self parseExplanation: each
	].
	^ operandInstantiationMap
]

{ #category : #parsing }
AcAArch64OpcodeParser >> parseFile: file [
	"Parse .xml file and return an instance of ProcessorInstructionDeclaration"

	| insns |

	file readStreamDo: [ :stream | insns := self parseDocument: (XMLDOMParser parse: stream) ].
	^ insns
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseFormat [
	| name bitfields |

	name := (document root attributeAt: 'id').
	bitfields := (document // 'regdiagram' / 'box') collect: [ :bitfieldNode | self parseFormatBitfield: bitfieldNode ].

	^ AcInstructionFormat name: name bitfields: bitfields.
]

{ #category : #'parsing - private' }
AcAArch64OpcodeParser >> parseFormatBitfield: bitfieldNode [
	| name width |

	(bitfieldNode includesAttribute: 'name') ifTrue: [
		name := bitfieldNode attributeAt: 'name'.
		width := 0.
		(bitfieldNode / 'c') do: [:c |
			width := width + (c attributeAt: 'colspan' ifAbsent:[ 1 ]) asInteger
		].

	] ifFalse: [
		"Fixed value field"
		name := 0.
		width := 0.
		(bitfieldNode / 'c') do: [:c |
			self assert: (c includesAttribute: 'colspan') not.
			self assert: (c strings size = 1).

			width := width + 1.
			name := (name << 1) | (c strings first = '1' ifTrue: [1] ifFalse: [0])
		].
	].

	(#('op' 'opcd' 'opcode') includes: name) ifTrue: [
		name := name , '0'.
	].

	^ AcInstructionBitfield name: name width: width signed: false.
]
